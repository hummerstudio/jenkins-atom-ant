{
  "atomCode": "ant",
  "name": "Ant",
  "version": "1.2.0",
  "description": "把 ant 插件变成一个原子：跑 ant target，退出码即构建结果。",
  "execution": {
    "packagePath": "ant.jar",
    "language": "java",
    "target": "$atom_java_path -cp ant.jar com.jenkinschina.atom.sdk.AtomRunner"
  },
  "input": {
    "goals": {
      "label": "target（空格分隔，如 clean dist）",
      "type": "vuex-input",
      "default": ""
    },
    "options": {
      "label": "额外参数（如 -DskipTests=true）",
      "type": "vuex-input",
      "default": ""
    },
    "home": {
      "label": "ant 安装目录（留空则用 PATH 或 $ANT_HOME）",
      "type": "vuex-input",
      "default": ""
    },
    "failOnError": {
      "label": "非零退出码视为构建失败",
      "type": "checkbox",
      "default": "true"
    }
  },
  "output": {
    "exitCode": {
      "type": "string",
      "description": "ant 的退出码"
    },
    "durationMs": {
      "type": "string",
      "description": "耗时（毫秒）"
    }
  },
  "x-jenkins": {
    "protocol": "jenkins-1",
    "requires": {
      "runner": ">=0.3.0"
    }
  }
}
